PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Base de datos local (o usa MYSQL_URL, que tiene prioridad y es lo que entrega Railway)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jalon
# MYSQL_URL=mysql://usuario:clave@host:3306/base

# SMS con Twilio (si se dejan vacíos, en desarrollo el código se muestra en pantalla y en la consola del servidor)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Usa UNO de los dos: un número de Twilio o un Messaging Service
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Solo para producción (Railway) ----
# NODE_ENV=production
# TRUST_PROXY=1                 # detrás del proxy de Railway, para que los límites de intentos usen la IP real
# UPLOADS_DIR=/data/uploads     # carpeta de un Volume para los documentos de los conductores
# ADMIN_PHONE=                  # crea el administrador inicial al arrancar (si todavía no existe ninguno)
# ADMIN_PASSWORD=
# SMS_DEV_ECHO=true             # solo para probar sin Twilio: muestra el código en pantalla. QUITAR al activar Twilio

# Notificaciones push (generar con: npm run vapid). Sin ellas todo funciona, solo que no hay notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://tu-dominio     # por defecto PUBLIC_URL si es https

# Llave para cifrar los documentos y los secretos del 2FA (32 bytes en base64). GUÁRDALA: sin ella no se recuperan los documentos.
# DATA_KEY=
